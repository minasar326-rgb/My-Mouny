{
  "id": "https://minasar326-rgb.github.io/My-Mouny/",
  "name": "my Mouny",
  "short_name": "my Mouny",
  "description": "my Mouny: تطبيق إدارة الأموال والمصاريف والحسابات أوفلاين ومشفر محلياً 100%.",
  "start_url": "/My-Mouny/?source=pwa",
  "scope": "/My-Mouny/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#f4f1eb",
  "theme_color": "#1c1a17",
  "dir": "rtl",
  "lang": "ar",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "scope_extensions": [
    {
      "origin": "https://minasar326-rgb.github.io"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.minasar.zakerm",
      "url": "https://play.google.com/store/apps/details?id=com.minasar.zakerm"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "file_handlers": [
    {
      "action": "/My-Mouny/",
      "name": "my Mouny Backup",
      "accept": {
        "application/json": [
          ".json",
          ".mouny"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/My-Mouny/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+mymouny",
      "url": "/My-Mouny/?action=%s"
    }
  ],
  "handle_links": "preferred",
  "widgets": [
    {
      "name": "my Mouny",
      "short_name": "Mouny",
      "description": "رصيدك وحساباتك السريعة",
      "tag": "mouny-widget",
      "template": "widget-template",
      "ms_ac_template": "widgets/balance.json",
      "data": "widgets/balance-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/My-Mouny/screenshots/screenshot-mobile.png",
          "sizes": "390x844",
          "label": "Widget preview"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/My-Mouny/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/My-Mouny/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/My-Mouny/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/My-Mouny/screenshots/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "واجهة تطبيق my Mouny على الهاتف المحمول"
