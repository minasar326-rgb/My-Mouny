{
  "id": "https://minasar326-rgb.github.io/My-Mouny/",
  "name": "my Mouny - إدارة المصاريف والخزنة المالية",
  "short_name": "my Mouny",
  "description": "my Mouny: تطبيق إدارة الأموال والمصاريف والحسابات والخزنة المالية المشفرة محلياً 100% بدون إنترنت وبدون خوادم.",
  "start_url": "/My-Mouny/?source=pwa",
  "scope": "/My-Mouny/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0d1520",
  "theme_color": "#0d1520",
  "dir": "rtl",
  "lang": "ar",
  "categories": [
    "finance",
    "productivity",
    "utilities",
    "business"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [],
  "scope_extensions": [
    {
      "origin": "https://minasar326-rgb.github.io"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        "*"
      ]
    },
    "new_tab_button": {
      "url": "/My-Mouny/"
    }
  },
  "note_taking": {
    "new_note_url": "/My-Mouny/?action=new_note"
  },
  "file_handlers": [
    {
      "action": "/My-Mouny/",
      "name": "نسخة احتياطية لتطبيق my Mouny",
      "accept": {
        "application/json": [
          ".json"
        ],
        "application/x-mymouny": [
          ".mouny"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/My-Mouny/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+mymouny",
      "url": "/My-Mouny/?action=%s"
    }
  ],
  "handle_links": "preferred",
  "widgets": [
    {
      "name": "my Mouny - رصيد الخزنة وصافي الثروة",
      "short_name": "my Mouny",
      "description": "عرض رصيد الخزنة ومصاريف الشهر وصافي الحسابات بضغطة واحدة",
      "tag": "mymouny-widget",
      "template": "widget-template",
      "ms_ac_template": "/My-Mouny/widgets/balance.json",
      "data": "/My-Mouny/widgets/balance-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/My-Mouny/screenshots/screenshot-mobile.png",
          "sizes": "390x844",
          "label": "معايانة ودجت my Mouny"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/My-Mouny/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/My-Mouny/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/My-Mouny/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/My-Mouny/screenshots/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "واجهة تطبيق my Mouny لإدارة المصاريف على الموبايل"
    },
    {
      "src": "/My-Mouny/screenshots/screenshot-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "لوحة إدارة المصاريف والخزنة المالية على الكمبيوتر والتابلت"
    }
  ],
  "shortcuts": [
    {
      "name": "سجّل شراء ومصروف",
