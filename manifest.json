{
  "id": "https://minasar326-rgb.github.io/Zaker-MB/",
  "name": "my Mouny - إدارة المصاريف والخزنة المالية",
  "short_name": "my Mouny",
  "description": "my Mouny: تطبيق إدارة الأموال والمصاريف والحسابات والخزنة المالية المشفرة محلياً 100% بدون إنترنت وبدون خوادم.",
  "start_url": "/Zaker-MB/?source=pwa",
  "scope": "/Zaker-MB/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0284c7",
  "dir": "rtl",
  "lang": "ar",
  "categories": [
    "finance",
    "productivity",
    "utilities",
    "business"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        "*"
      ]
    },
    "new_tab_button": {
      "url": "/Zaker-MB/"
    }
  },
  "note_taking": {
    "new_note_url": "/Zaker-MB/?action=new_note"
  },
  "file_handlers": [
    {
      "action": "/Zaker-MB/",
      "name": "نسخة احتياطية لتطبيق my Mouny",
      "accept": {
        "application/json": [
          ".json"
        ],
        "application/x-mymouny": [
          ".mouny"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/Zaker-MB/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+mymouny",
      "url": "/Zaker-MB/?action=%s"
    }
  ],
  "handle_links": "preferred",
  "widgets": [
    {
      "name": "my Mouny - رصيد الخزنة وصافي الثروة",
      "short_name": "my Mouny",
      "description": "عرض رصيد الخزنة ومصاريف الشهر وصافي الحسابات بضغطة واحدة",
      "tag": "mymouny-widget",
      "template": "widget-template",
      "ms_ac_template": "/Zaker-MB/widgets/balance.json",
      "data": "/Zaker-MB/widgets/balance-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/Zaker-MB/screenshots/screenshot-mobile.png",
          "sizes": "390x844",
          "label": "معاينة ودجت my Mouny"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/Zaker-MB/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/Zaker-MB/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/Zaker-MB/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/Zaker-MB/screenshots/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "واجهة تطبيق my Mouny لإدارة المصاريف على الموبايل"
    },
    {
      "src": "/Zaker-MB/screenshots/screenshot-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "لوحة إدارة المصاريف والخزنة المالية على الكمبيوتر والتابلت"
    }
  ],
  "shortcuts": [
    {
      "name": "سجّل شراء ومصروف",
