        {
          "src": "/My-Mouny/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "مؤقت التركيز والمذاكرة",
      "short_name": "مؤقت المذاكرة",
      "description": "بدء جلسة مذاكرة بومودورو للتركيز العالي",
      "url": "/My-Mouny/?action=timer",
      "icons": [
        {
          "src": "/My-Mouny/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
