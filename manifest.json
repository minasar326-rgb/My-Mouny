{
  "id": "https://minasar326-rgb.github.io/My-Mouny/",
  "name": "my Mouny",
  "short_name": "my Mouny",
  "description": "my Mouny: تطبيق إدارة الأموال والمصاريف والحسابات أوفلاين ومشفر محلياً 100% بدون خوادم.",
  "start_url": "/My-Mouny/?source=pwa",
  "scope": "/My-Mouny/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0284c7",
  "dir": "rtl",
  "lang": "ar",
  "categories": [
    "finance",
    "productivity",
    "utilities",
    "business"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        "*"
      ]
    },
    "new_tab_button": {
      "url": "/My-Mouny/"
    }
  },
  "note_taking": {
    "new_note_url": "/My-Mouny/?action=new_note"
  },
  "file_handlers": [
    {
      "action": "/My-Mouny/",
      "name": "ملفات وملاحظات المذاكرة لتطبيق ذاكر",
      "accept": {
        "application/json": [
          ".json"
        ],
        "application/x-zaker": [
          ".zaker"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/My-Mouny/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+zaker",
      "url": "/My-Mouny/?action=%s"
    }
  ],
  "handle_links": "preferred",
  "widgets": [
    {
      "name": "ذاكر - جدول المذاكرة اليومي",
      "short_name": "جدول ذاكر",
      "description": "عرض جدول المذاكرة والمهام اليومية وتنظيم اليوم الدراسي بضغطة واحدة",
      "tag": "zaker-widget",
      "template": "widget-template",
      "ms_ac_template": "/My-Mouny/widgets/balance.json",
      "data": "/My-Mouny/widgets/balance-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/My-Mouny/screenshots/screenshot-mobile.png",
          "sizes": "390x844",
          "label": "معاينة ودجت ذاكر"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/My-Mouny/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/My-Mouny/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/My-Mouny/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/My-Mouny/screenshots/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "واجهة تطبيق ذاكر لتنظيم المذاكرة على الهاتف المحمول"
    },
    {
      "src": "/My-Mouny/screenshots/screenshot-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "لوحة تنظيم اليوم الدراسي وجدول المهام اليومية في ذاكر"
    }
  ],
  "shortcuts": [
    {
      "name": "جدول المذاكرة اليومي",
      "short_name": "جدول المذاكرة",
      "description": "عرض جدول الحصص والمهام الدراسية لليوم",
      "url": "/My-Mouny/?action=schedule",
      "icons": [
        {
          "src": "/My-Mouny/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "إضافة مهمة دراسية جديدة",
      "short_name": "مهمة جديدة",
      "description": "تسجيل واجب مدرسي أو مراجعة يومية",
      "url": "/My-Mouny/?action=new_task",
