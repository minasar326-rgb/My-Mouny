          "src": "/My-Mouny/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "الخزنة المالية والديون",
      "short_name": "الخزنة",
      "description": "عرض ما لك وما عليك والخزنة المشفرة",
      "url": "/My-Mouny/My-Mouny/?action=vault",
